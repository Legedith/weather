# Server only. Never commit a real value or use this key in the browser build.
GOOGLE_WEATHER_API_KEY=
# Exact origins, not paths; no trailing slash. Add localhost only for development.
ALLOWED_ORIGINS=https://legedith.github.io
PORT=8080
# Per process, resets on restart. Also enforce Google quotas and edge limits.
MAX_UPSTREAM_REQUESTS_PER_DAY=500
# Public build-time setting; no credentials. Set as a GitHub Actions variable.
GOOGLE_WEATHER_PROXY_URL=
