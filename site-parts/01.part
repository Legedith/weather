    .controls-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px}.controls-title span:first-child{font-size:12px;font-weight:800;color:#344f69}.controls-title span:last-child{font-size:11px;color:var(--muted)}
    .horizon{display:grid;grid-template-columns:88px 1fr;gap:8px}
    .horizon input{height:48px;width:100%;border:1px solid var(--line);border-radius:14px;background:#fff;color:var(--ink);font-size:19px;font-weight:800;text-align:center;outline:none}
    .segmented{display:grid;grid-template-columns:1fr 1fr;background:#eaf1f8;border-radius:14px;padding:4px;gap:3px}
    .segmented button{border:0;border-radius:11px;background:transparent;color:#597088;font-weight:800;font-size:12.5px}.segmented button.active{background:white;color:#173a5e;box-shadow:0 5px 15px rgba(37,72,109,.12)}
    .forecast-btn{width:100%;height:52px;margin-top:10px;border:0;border-radius:15px;color:white;background:linear-gradient(135deg,#0f61eb,#1d83fb);font-weight:800;letter-spacing:.01em;box-shadow:0 13px 28px rgba(29,112,247,.26);position:relative;overflow:hidden;transition:transform .16s,box-shadow .16s}
    .forecast-btn:hover{transform:translateY(-1px);box-shadow:0 16px 32px rgba(29,112,247,.30)}
    .forecast-btn:active{transform:translateY(0)}
    .forecast-btn[disabled]{opacity:.7;cursor:wait}
    .forecast-btn .spinner{width:16px;height:16px;border:2px solid rgba(255,255,255,.35);border-top-color:white;border-radius:50%;display:none;animation:spin .7s linear infinite;vertical-align:-3px;margin-right:8px}.forecast-btn.loading .spinner{display:inline-block}@keyframes spin{to{transform:rotate(360deg)}}
    .microcopy{margin:10px 2px 0;font-size:10.5px;line-height:1.5;color:#7a8ea3}

    .forecast-panel{padding:18px;min-height:690px}
    .forecast-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin:2px 2px 14px}
    .forecast-top h2{font-size:23px;margin-top:3px}.forecast-top .sub{margin-top:6px;color:var(--muted);font-size:12.5px}
    .updated{font-size:10.5px;color:#6d8297;background:#f7fafe;border:1px solid #e0e9f3;border-radius:999px;padding:7px 9px;white-space:nowrap}
    .hero-grid{display:grid;grid-template-columns:1.25fr repeat(3,1fr);gap:10px;margin-bottom:12px}
    .hero{min-height:116px;border-radius:19px;padding:16px;border:1px solid #dce7f2;background:#fff;position:relative;overflow:hidden}
    .hero.primary{background:linear-gradient(145deg,#0e5cdd 0%,#1888f7 62%,#36a7f6 100%);color:white;border:0;box-shadow:0 14px 34px rgba(20,111,226,.22)}
    .hero.primary:after{content:"";position:absolute;width:130px;height:130px;border:24px solid rgba(255,255,255,.08);border-radius:50%;right:-53px;top:-57px}
    .hero .label{font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:800;color:#7e91a4}.hero.primary .label{color:rgba(255,255,255,.72)}
    .hero .value{font-size:27px;line-height:1;font-weight:850;letter-spacing:-.04em;margin-top:12px}.hero.primary .value{font-size:25px;max-width:220px;line-height:1.03}
    .hero .meta{margin-top:8px;color:#71879b;font-size:11px;line-height:1.35}.hero.primary .meta{color:rgba(255,255,255,.77);max-width:240px}
    .mini-icon{position:absolute;right:13px;bottom:12px;width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:#f2f7fd;color:var(--blue)}
    .hero.primary .mini-icon{background:rgba(255,255,255,.14);color:white}

    .chart-card{background:#fff;border:1px solid #dce7f2;border-radius:20px;padding:14px 14px 10px;position:relative;overflow:hidden}
    .chart-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:4px;padding:0 2px}.chart-head h3{font-size:13px;margin:0;color:#304c67}.legend{display:flex;align-items:center;gap:12px;color:#6d8297;font-size:10.5px}.legend span{display:inline-flex;align-items:center;gap:5px}.dot{width:8px;height:8px;border-radius:50%}.dot.temp{background:var(--amber)}.dot.rain{background:var(--blue)}.band{width:13px;height:7px;border-radius:4px;background:rgba(245,158,11,.18);border:1px solid rgba(217,119,6,.22)}
    .chart-wrap{height:286px;position:relative}.chart-wrap canvas{width:100%;height:100%;display:block}
    .tooltip{position:absolute;pointer-events:none;display:none;z-index:10;min-width:164px;padding:9px 10px;border-radius:12px;background:rgba(17,36,58,.94);color:white;box-shadow:0 10px 26px rgba(17,36,58,.22);font-size:10.5px;line-height:1.45}.tooltip strong{font-size:11.5px}.tooltip .trow{display:flex;justify-content:space-between;gap:12px;margin-top:4px}.tooltip .muted{color:rgba(255,255,255,.66)}
    .chart-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 2px 0;font-size:10px;color:#8194a7}.chart-foot b{color:#577089}

    .section-title{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:17px 2px 9px}.section-title h3{font-size:14px;margin:0;color:#2c4863}.section-title p{font-size:10.5px;margin:0;color:#7a8ea3}
    .days{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
    .day-card{border:1px solid #dce7f2;background:#fff;border-radius:17px;padding:12px;min-width:0}.day-head{display:flex;align-items:flex-start;justify-content:space-between;gap:7px}.day-name{font-size:12px;font-weight:850}.day-date{font-size:9.5px;color:#8699aa;margin-top:2px}.rain-badge{font-size:9px;font-weight:800;padding:4px 6px;border-radius:999px;background:#edf5ff;color:#1c66cf;white-space:nowrap}.day-temp{font-size:20px;font-weight:850;letter-spacing:-.035em;margin-top:12px}.day-temp small{font-size:11px;color:#8295a8;font-weight:700}.day-rain{margin-top:8px;font-size:10px;color:#637b91}.rain-track{height:5px;border-radius:99px;background:#e8f0f8;overflow:hidden;margin-top:6px}.rain-track span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#76c4ff,#1376ef)}

    .timeline-card{background:#fff;border:1px solid #dce7f2;border-radius:20px;overflow:hidden}.timeline-head,.timeline-row{display:grid;grid-template-columns:1.45fr .75fr .82fr .8fr;gap:10px;align-items:center}.timeline-head{padding:10px 13px;background:#f7fafe;color:#7b8fa4;font-size:9.5px;text-transform:uppercase;letter-spacing:.08em;font-weight:850;border-bottom:1px solid #e4edf6}.timeline-body{max-height:370px;overflow:auto}.timeline-row{padding:10px 13px;border-bottom:1px solid #edf2f7;font-size:11.5px;color:#415d77}.timeline-row:last-child{border-bottom:0}.timeline-row:hover{background:#fbfdff}.time-main{font-weight:800;color:#27445f}.time-sub{font-size:9.5px;color:#8a9bac;margin-top:2px}.temp-cell{font-weight:850;color:#b86a08}.rain-cell{font-weight:800;color:#176bd5}.amount-cell{font-weight:750}.rain-symbol{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;background:#4ca8ff;vertical-align:1px}
    .empty{display:grid;place-items:center;min-height:610px;text-align:center;padding:36px}.empty-art{width:112px;height:112px;border-radius:32px;background:linear-gradient(145deg,#e5f2ff,#f8fbff);display:grid;place-items:center;margin:0 auto 18px;border:1px solid #d7e6f5}.empty h2{font-size:20px;margin:0}.empty p{font-size:12.5px;line-height:1.55;color:var(--muted);max-width:390px;margin:8px auto 0}.empty .arrow{margin-top:18px;font-size:11px;color:#6f86a0;background:white;border:1px solid #dfe9f3;border-radius:999px;padding:8px 11px}
    .error-card{display:none;margin:12px 0 0;border:1px solid #ffd4d4;background:#fff8f8;color:#9d3333;border-radius:14px;padding:10px 12px;font-size:11.5px;line-height:1.45}.error-card.visible{display:block}
