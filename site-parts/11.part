      // Temperature line
      ctx.beginPath();points.forEach((p,i)=>{const xx=x(i),yy=yT(p.temp);i?ctx.lineTo(xx,yy):ctx.moveTo(xx,yy);});ctx.strokeStyle='#cc7200';ctx.lineWidth=2.6;ctx.lineJoin='miter';ctx.lineCap='square';ctx.stroke();
      if(points.length<=72){points.forEach((p,i)=>{ctx.beginPath();ctx.arc(x(i),yT(p.temp),2.1,0,Math.PI*2);ctx.fillStyle='#ffb000';ctx.fill();});}

      // X labels
      ctx.fillStyle='#494756';ctx.font='bold 9.5px Courier New,monospace';ctx.textAlign='center';const labels=Math.min(5,points.length);for(let j=0;j<labels;j++){const idx=Math.round(j*(points.length-1)/Math.max(1,labels-1));const label=points.length<=72?formatPointTime(points[idx].time,false):formatPointTime(points[idx].time,true).split(' · ')[0];ctx.fillText(label,x(idx),H-8);}
      ctx.textAlign='left';
      latestChartLayout={points,x,yT,pad,plotW,plotH,W,H};
    }
    function roundRect(ctx,x,y,w,h,r){r=Math.min(r,w/2,h/2);ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}
    window.addEventListener('resize',()=>{if(latestPoints.length)requestAnimationFrame(()=>drawChart(latestPoints));});
    chartWrap.addEventListener('mousemove',e=>{
      if(!latestChartLayout||!latestPoints.length)return;const rect=chartWrap.getBoundingClientRect();const mx=e.clientX-rect.left;const {pad,plotW}=latestChartLayout;if(mx<pad.l||mx>pad.l+plotW){chartTooltip.style.display='none';return;}const i=latestPoints.length===1?0:Math.round((mx-pad.l)/plotW*(latestPoints.length-1));const p=latestPoints[clamp(i,0,latestPoints.length-1)];
      chartTooltip.innerHTML=`<strong>${formatPointTime(p.time,true)}</strong><div class="trow"><span class="muted">Temperature</span><span>${p.temp.toFixed(1)}°C</span></div><div class="trow"><span class="muted">Likely range</span><span>${p.temp10.toFixed(1)}–${p.temp90.toFixed(1)}°</span></div><div class="trow"><span class="muted">Rain chance</span><span>${Math.round(p.rainProb)}%</span></div><div class="trow"><span class="muted">Expected rain</span><span>${formatRain(p.rain)} mm</span></div>`;
      chartTooltip.style.display='block';const tw=chartTooltip.offsetWidth,th=chartTooltip.offsetHeight;let left=mx+12,top=e.clientY-rect.top-th-12;if(left+tw>rect.width-4)left=mx-tw-12;if(top<4)top=e.clientY-rect.top+12;chartTooltip.style.left=left+'px';chartTooltip.style.top=top+'px';
    });
    chartWrap.addEventListener('mouseleave',()=>chartTooltip.style.display='none');

    // Initial UI
    latInput.value=pin.lat.toFixed(4);lonInput.value=pin.lon.toFixed(4);setUnit(unit);renderMap();
    setTimeout(()=>renderMap(),80);
  })();
  </script>
</body>
</html>
