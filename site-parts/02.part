    .loading-overlay{position:absolute;inset:0;background:rgba(247,251,255,.74);backdrop-filter:blur(3px);display:none;place-items:center;z-index:30}.loading-overlay.visible{display:grid}.loader-card{background:#fff;border:1px solid #dce7f2;border-radius:17px;padding:14px 17px;box-shadow:var(--shadow-sm);display:flex;align-items:center;gap:10px;color:#4a657f;font-size:12px;font-weight:700}.loader-card .spinner{width:18px;height:18px;border:2px solid #d8e7f9;border-top-color:var(--blue);border-radius:50%;animation:spin .7s linear infinite}
    .forecast-content{display:none}.forecast-content.visible{display:block}
    footer{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:13px 3px 0;font-size:9.5px;color:#8295a8;line-height:1.45}footer a{color:#58758f}
    .toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:#17334f;color:white;border-radius:13px;padding:10px 13px;font-size:11.5px;box-shadow:0 14px 38px rgba(15,40,66,.24);opacity:0;pointer-events:none;transition:.22s;z-index:100}.toast.show{opacity:1;transform:translate(-50%,0)}

    @media(max-width:1040px){
      .shell{grid-template-columns:1fr}.left-panel{position:relative;top:0}.map-wrap{height:430px}.forecast-panel{min-height:0}.hero-grid{grid-template-columns:1.25fr 1fr 1fr}.hero-grid .hero:nth-child(4){grid-column:span 3;min-height:88px}.days{grid-template-columns:repeat(3,minmax(0,1fr))}
    }
    @media(max-width:720px){
      .app{padding:13px 10px 24px}.topbar{margin:2px 4px 13px}.model-pill{display:none}.brand p{font-size:11.5px}.panel{border-radius:20px}.panel-head{padding:16px 15px 12px}.map-wrap{margin:0 9px;height:52vh;min-height:330px;max-height:470px;border-radius:17px}.location-tools{padding:11px 9px 3px}.controls{padding:12px 13px 15px}.forecast-panel{padding:12px}.forecast-top{margin:2px 2px 10px}.forecast-top h2{font-size:20px}.updated{display:none}.hero-grid{grid-template-columns:1fr 1fr}.hero.primary{grid-column:span 2}.hero-grid .hero:nth-child(4){grid-column:auto}.hero{min-height:103px;padding:14px}.hero .value{font-size:24px}.chart-card{padding:12px 9px 8px}.chart-wrap{height:240px}.legend{gap:8px}.legend span:nth-child(2){display:none}.days{display:flex;overflow-x:auto;padding-bottom:3px;scrollbar-width:none}.days::-webkit-scrollbar{display:none}.day-card{min-width:142px}.timeline-head,.timeline-row{grid-template-columns:1.5fr .7fr .78fr}.timeline-head div:last-child,.timeline-row div:last-child{display:none}.timeline-body{max-height:330px}.search-row{grid-template-columns:1fr}.locate-btn{display:none}.coords{grid-template-columns:1fr 1fr}.map-note{font-size:10.5px;max-width:205px}.empty{min-height:480px}
    }
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation-duration:.001ms!important;transition-duration:.001ms!important}}


    /* =========================================================
       RETRO MODE — 8-bit / early-internet pop skin
       ========================================================= */
    :root{
      --bg:#fff7d6;
      --surface:#fffdf5;
      --surface-solid:#fffdf5;
      --ink:#15151b;
      --muted:#5c5b69;
      --line:#15151b;
      --blue:#3155ff;
      --blue-deep:#1532c6;
      --blue-soft:#dff5ff;
      --cyan:#18d9e6;
      --amber:#ffb000;
      --amber-deep:#cc7200;
      --green:#00a86b;
      --red:#ed3b76;
      --pink:#ff4da6;
      --purple:#7952ff;
      --yellow:#ffe34d;
      --shadow:7px 7px 0 #15151b;
      --shadow-sm:4px 4px 0 #15151b;
      --radius:7px;
      --radius-sm:5px;
      --focus:0 0 0 3px #fff,0 0 0 6px #3155ff;
    }
    html{image-rendering:auto}
    html,body{
      font-family:"Courier New",Courier,ui-monospace,monospace;
      letter-spacing:-.015em;
    }
    body{
      background-color:#fff7d6;
      background-image:
        linear-gradient(rgba(49,85,255,.09) 1px,transparent 1px),
        linear-gradient(90deg,rgba(49,85,255,.09) 1px,transparent 1px),
        linear-gradient(135deg,rgba(255,77,166,.08) 25%,transparent 25%),
        linear-gradient(315deg,rgba(24,217,230,.08) 25%,transparent 25%);
      background-size:18px 18px,18px 18px,54px 54px,54px 54px;
      background-position:0 0,0 0,0 0,27px 27px;
    }
    body:before{
      content:"";
      position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:.16;
      background:repeating-linear-gradient(180deg,transparent 0 3px,rgba(20,20,30,.12) 3px 4px);
      mix-blend-mode:multiply;
    }
    ::selection{background:var(--pink);color:#fff}
    .app{padding-top:18px}

    .topbar{
      position:relative;
      border:3px solid var(--ink);
      background:#fff;
      padding:12px 14px;
      box-shadow:var(--shadow-sm);
      margin-bottom:14px;
    }
    .topbar:after{
      content:"RAIN.EXE  ·  ONLINE";
      position:absolute;right:12px;bottom:-11px;
      padding:2px 7px;border:2px solid var(--ink);
      background:var(--yellow);color:var(--ink);
      font-size:9px;font-weight:900;letter-spacing:.08em;
    }
    .logo{
      width:48px;height:48px;border-radius:4px;border:3px solid var(--ink);
      background:var(--blue);box-shadow:4px 4px 0 var(--pink);
    }
    .logo svg{width:29px;height:29px;filter:contrast(1.2)}
    .brand h1{
      font-family:"Courier New",Courier,monospace;
      font-size:clamp(19px,2.1vw,28px);font-weight:900;letter-spacing:-.065em;
      text-transform:uppercase;text-shadow:2px 2px 0 #bfefff;
    }
    .brand p{color:#454453;font-weight:700}
    .model-pill{
      border:3px solid var(--ink);border-radius:4px;background:#e8fff4;color:#15151b;
      box-shadow:3px 3px 0 var(--ink);font-weight:800;
    }
    .pulse{border-radius:0;background:#00c878;box-shadow:none;animation:retroBlink 1.15s steps(2,end) infinite}

    .retro-marquee{
      overflow:hidden;border:3px solid var(--ink);background:#14141c;color:#fff;
      box-shadow:var(--shadow-sm);margin:0 0 16px;height:30px;display:flex;align-items:center;
      white-space:nowrap;font-size:10px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;
    }
    .retro-marquee-track{display:inline-block;min-width:100%;padding-left:100%;animation:retroScroll 24s linear infinite}
    .retro-marquee b{color:#72f5ff}.retro-marquee i{color:#ffe34d;font-style:normal}.retro-marquee strong{color:#ff77b9}
    @keyframes retroScroll{to{transform:translateX(-100%)}}
    @keyframes retroBlink{50%{opacity:.25}}

    .shell{gap:20px}
    .panel{
      background:var(--surface);border:3px solid var(--ink);border-radius:var(--radius);
      box-shadow:var(--shadow);backdrop-filter:none;
    }
    .panel-head{background:linear-gradient(90deg,#c8fbff 0 63%,#ffd3ea 63%);border-bottom:3px solid var(--ink);padding:14px 16px 13px}
    .eyebrow{color:#15151b;background:var(--yellow);display:inline-block;border:2px solid var(--ink);padding:3px 6px;letter-spacing:.08em;box-shadow:2px 2px 0 var(--ink)}
    h2,.forecast-top h2,.section-title h3,.chart-head h3{letter-spacing:-.045em}
    .hint{color:#494856;font-weight:700}

    .map-wrap{
      margin:14px;border:3px solid var(--ink);border-radius:3px;background:#92dbe7;
      box-shadow:4px 4px 0 #89e9ef;
    }
    #map{background:#b8eaf0}
    .tile{filter:saturate(.72) contrast(1.02)}
    .marker{filter:drop-shadow(4px 4px 0 rgba(21,21,27,.55))}
    .marker svg path{fill:#ff3f93}
    .map-crosshair{opacity:.62}
    .map-crosshair:before,.map-crosshair:after{background:#15151b;border-radius:0}
    .map-note{
      border:2px solid var(--ink);border-radius:2px;background:#15151b;color:#fff;
      box-shadow:3px 3px 0 var(--yellow);backdrop-filter:none;font-weight:700;
    }
    .map-toolbar{gap:8px}
    .map-btn{
      border:3px solid var(--ink);border-radius:3px;background:#fff;color:#15151b;
      box-shadow:3px 3px 0 var(--ink);font-family:inherit;font-weight:900;
    }
    .map-btn:hover{background:var(--yellow);transform:translate(-1px,-1px);box-shadow:4px 4px 0 var(--ink)}
